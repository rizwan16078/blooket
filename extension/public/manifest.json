{
  "manifest_version": 3,
  "name": "Blooket Calculator",
  "version": "1.0.0",
  "description": "The most accurate Blooket pack calculator. Calculate odds, plan token spending, and find the best packs. By calculatorblooket.com",
  "permissions": ["storage"],
  "host_permissions": ["https://*.blooket.com/"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Blooket Calculator"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.blooket.com/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  }
}
