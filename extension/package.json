{
  "name": "blooket-calculator-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build && node scripts/post-build.mjs",
    "package": "npm run build && cd dist && Compress-Archive -Path * -DestinationPath ..\\blooket-calculator-extension.zip -Force"
  },
  "dependencies": {
    "preact": "^10.22.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.8.0",
    "@types/chrome": "^0.1.42",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
